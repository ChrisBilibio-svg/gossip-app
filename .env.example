# Supabase — copy this file to `.env` and fill in from:
# Supabase dashboard → Settings → API
# The anon key is safe in a client app (RLS governs access). Do NOT use the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
